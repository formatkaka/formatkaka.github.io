---
import { martyrs } from '../kargil-remembrance/martyrs';
import { battleArchive, getCommonsFileUrl } from './archive';
import { getRemembrancesForScene } from './remembrances';
import { battleScenes } from './scenes';
import { storyChapters } from './story';
import { localeLabels, uiCopy } from './locales';
import './styles.css';

const wallEntries = Array.from({ length: 5 }, (_, repetition) =>
  martyrs.map((martyr, soldierIndex) => ({ martyr, repetition, soldierIndex }))
).flat();
const campaignSectors = [
  { id: 'dras', label: 'Dras' },
  { id: 'kaksar', label: 'Kaksar' },
  { id: 'batalik', label: 'Batalik' },
  { id: 'turtuk', label: 'Turtuk' },
];
const initialRemembrances = getRemembrancesForScene(0);
---

<main class="name-wall-experiment">
  <div class="name-wall-experiment__language" role="group" aria-label={uiCopy.en.languageLabel} data-language-switcher>
    <span data-i18n="languageLabel">{uiCopy.en.languageLabel}</span>
    <button type="button" data-language="en" aria-pressed="true">{localeLabels.en}</button>
    <button type="button" data-language="hi" aria-pressed="false">{localeLabels.hi}</button>
  </div>
  <section class="name-wall-experiment__intro" aria-labelledby="name-wall-title">
    <p class="name-wall-experiment__eyebrow" data-i18n="remembranceEyebrow">{uiCopy.en.remembranceEyebrow}</p>
    <h1 id="name-wall-title" data-i18n="introTitle" data-i18n-html>Names across<br />the heights.</h1>
    <p class="name-wall-experiment__lede" data-i18n="introLede">{uiCopy.en.introLede}</p>
    <p class="name-wall-experiment__scope" data-i18n="introScope">{uiCopy.en.introScope}</p>
    <button type="button" data-experience-begin>
      <span data-i18n="begin">{uiCopy.en.begin}</span> <span aria-hidden="true">↓</span>
    </button>
  </section>

  <section
    id="how-the-war-began"
    class="name-wall-experiment__story name-wall-experiment__story--beginning"
    aria-labelledby="beginning-title"
  >
    <figure class="name-wall-experiment__story-image">
      <img src={storyChapters.beginning.image} alt={storyChapters.beginning.imageAlt} />
      <figcaption>
        <a href={storyChapters.beginning.imageUrl} target="_blank" rel="noreferrer">
          Photograph: {storyChapters.beginning.imageCredit} ↗
        </a>
      </figcaption>
    </figure>
    <div class="name-wall-experiment__story-copy">
      <p class="name-wall-experiment__eyebrow" data-story="beginning-eyebrow">{storyChapters.beginning.eyebrow}</p>
      <h2 id="beginning-title" data-story="beginning-title">{storyChapters.beginning.title}</h2>
      {storyChapters.beginning.paragraphs.map((paragraph, index) => <p data-story={`beginning-paragraph-${index}`}>{paragraph}</p>)}
      <ul aria-label="Beginning of the war in brief">
        {storyChapters.beginning.facts.map((fact, index) => <li data-story={`beginning-fact-${index}`}>{fact}</li>)}
      </ul>
      <div class="name-wall-experiment__story-links">
        <a href="#name-wall-journey">Enter the name wall <span aria-hidden="true">↓</span></a>
        <a href={storyChapters.beginning.sourceUrl} target="_blank" rel="noreferrer">
          {storyChapters.beginning.sourceLabel} ↗
        </a>
      </div>
    </div>
  </section>

  <section
    id="campaign-geography"
    class="name-wall-experiment__campaign-map"
    aria-labelledby="campaign-map-title"
    hidden
  >
    <div class="name-wall-experiment__map-copy">
      <h2 id="campaign-map-title" data-i18n="campaignTitle">{uiCopy.en.campaignTitle}</h2>
      <p data-i18n="campaignBody">
        From Mushkoh and Dras through Kaksar and Batalik toward Turtuk, troops fought to recover
        commanding heights. The Srinagar–Leh road below made those positions strategically vital.
      </p>
      <div class="name-wall-experiment__map-key" aria-label="Map key" data-i18n-aria="mapKey">
        <span><i data-key="loc"></i> <span data-i18n="lineOfControl">{uiCopy.en.lineOfControl}</span></span>
        <span><i data-key="road"></i> <span data-i18n="road">{uiCopy.en.road}</span></span>
        <span><i data-key="front"></i> <span data-i18n="fronts">{uiCopy.en.fronts}</span></span>
      </div>
      <p class="name-wall-experiment__map-note" data-i18n="schematic">
        Schematic · not to scale. Geography based on the official Kargil Vijay Diwas campaign
        diagram.
      </p>
      <div class="name-wall-experiment__map-actions">
        <a href="#name-wall-journey">
          <span data-i18n="followCampaign">{uiCopy.en.followCampaign}</span> <span aria-hidden="true">↓</span>
        </a>
        <a
          href="https://static.pib.gov.in/WriteReadData/userfiles/Kargil%20Vijay%20Diwas%20PPT%20Col.%20Amit%20Dalvi%20July%2026%202020.pdf"
          target="_blank"
          rel="noreferrer"><span data-i18n="officialDiagram">{uiCopy.en.officialDiagram}</span> ↗</a
        >
      </div>
    </div>

    <figure class="name-wall-experiment__map-figure">
      <svg
        viewBox="0 0 880 610"
        role="img"
        aria-labelledby="campaign-map-svg-title campaign-map-svg-description"
      >
        <title id="campaign-map-svg-title">Schematic of the Kargil campaign area</title>
        <desc id="campaign-map-svg-description">
          A west-to-east schematic showing Mushkoh, Dras, Kaksar, Kargil, Batalik and Turtuk, with
          the Line of Control above the Srinagar–Leh road.
        </desc>
        <g class="name-wall-experiment__map-contours" aria-hidden="true">
          <path d="M18 104C124 37 202 77 295 45s172 9 257-25 198 14 312-8"></path>
          <path d="M-5 158c117-70 213-19 314-56s171 4 266-29 190 16 316-17"></path>
          <path d="M-20 518c111-51 201-29 304-3s189 34 283 2 208-29 333 12"></path>
          <path d="M4 567c118-44 211-3 311 13s171 1 268-20 194-12 303 22"></path>
        </g>
        <path
          class="name-wall-experiment__map-loc"
          d="M26 225C115 169 166 207 248 172s146-11 213-62 129-13 188-42 133-12 203-37"></path>
        <text class="name-wall-experiment__map-line-label" x="38" y="196">LINE OF CONTROL</text>
        <path
          class="name-wall-experiment__map-road"
          d="M18 445C133 407 208 426 300 394s189-36 285-19 173 3 277-41"></path>
        <text class="name-wall-experiment__map-road-label" x="30" y="479">FROM SRINAGAR</text>
        <text class="name-wall-experiment__map-road-label" x="742" y="369">TOWARD LEH</text>

        <g class="name-wall-experiment__map-front" transform="translate(118 344)">
          <circle r="11"></circle><circle r="25"></circle><text y="-42">MUSHKOH</text>
        </g>
        <g class="name-wall-experiment__map-front" transform="translate(248 326)">
          <circle r="11"></circle><circle r="25"></circle><text y="-42">DRAS</text>
        </g>
        <g class="name-wall-experiment__map-height" transform="translate(208 242)">
          <path d="m0-9 9 18H-9Z"></path><text x="-12" y="-19">TIGER HILL</text>
        </g>
        <g class="name-wall-experiment__map-height" transform="translate(278 258)">
          <path d="m0-9 9 18H-9Z"></path><text x="12" y="4">TOLOLING</text>
        </g>
        <g class="name-wall-experiment__map-height" transform="translate(325 302)">
          <path d="m0-9 9 18H-9Z"></path><text x="12" y="4">POINT 4875</text>
        </g>
        <g class="name-wall-experiment__map-front" transform="translate(410 298)">
          <circle r="11"></circle><circle r="25"></circle><text y="-42">KAKSAR</text>
        </g>
        <g class="name-wall-experiment__map-town" transform="translate(508 350)">
          <circle r="7"></circle><text y="30">KARGIL</text>
        </g>
        <g class="name-wall-experiment__map-front" transform="translate(650 269)">
          <circle r="11"></circle><circle r="25"></circle><text y="-42">BATALIK</text>
        </g>
        <g class="name-wall-experiment__map-height" transform="translate(695 184)">
          <path d="m0-9 9 18H-9Z"></path><text x="12" y="4">KHALUBAR</text>
        </g>
        <g class="name-wall-experiment__map-front" transform="translate(798 132)">
          <circle r="11"></circle><circle r="25"></circle><text x="-9" y="-42">TURTUK</text>
        </g>
        <g class="name-wall-experiment__map-town" transform="translate(70 432)">
          <circle r="7"></circle><text y="30">SONAMARG</text>
        </g>
      </svg>
      <figcaption>
        Several fronts. One road below. Heights recovered position by position.
      </figcaption>
    </figure>
  </section>

  <section
    id="name-wall-journey"
    class="name-wall-experiment__journey"
    data-name-wall-journey
    tabindex="-1"
    aria-label="Eight chapters from Operation Vijay"
  >
    <div class="name-wall-experiment__stage" data-name-wall-stage>
      <header class="name-wall-experiment__header">
        <span class="name-wall-experiment__identity">
          <span class="name-wall-experiment__flag" role="img" aria-label="Flag of India">
            <span></span>
            <span><i></i></span>
            <span></span>
          </span>
          <span data-i18n="operationVijay">{uiCopy.en.operationVijay}</span>
        </span>
        <span data-i18n="selectedNames">{uiCopy.en.selectedNames}</span>
        <span>Kargil, 1999</span>
      </header>

      <div class="name-wall-experiment__wall" data-name-wall aria-hidden="true">
        {
          wallEntries.map(({ martyr, repetition, soldierIndex }) => (
            <>
              <span
                class="name-wall-experiment__name"
                data-wall-name
                data-soldier-index={soldierIndex}
                data-repetition={repetition}
              >
                {martyr.fullName}
              </span>
              <span class="name-wall-experiment__separator">·</span>
            </>
          ))
        }
      </div>

      <div class="name-wall-experiment__clearance" data-name-wall-clearance aria-hidden="true">
      </div>

      <div class="name-wall-experiment__chakra" data-name-wall-chakra aria-hidden="true">
        <span class="name-wall-experiment__chakra-ring"></span>
        <span class="name-wall-experiment__chakra-hub"></span>
        {
          Array.from({ length: 24 }, (_, index) => (
            <span
              class="name-wall-experiment__spoke"
              data-spoke-index={index}
              style={`--spoke: ${index}`}
            />
          ))
        }
      </div>

      <p class="name-wall-experiment__sr-only" aria-live="polite" data-scene-announcement>
        Chapter 1 of {battleScenes.length}: {battleScenes[0].title}. Names brought forward:
        {battleScenes[0].soldierIndices.map((index) => martyrs[index]?.fullName).join(', ')}.
      </p>

      <aside class="name-wall-experiment__context" aria-label="Current chapter" data-i18n-aria="currentChapter">
        <div class="name-wall-experiment__context-count">
          <span data-scene-number>01</span>
          <span>/</span>
          <span>{String(battleScenes.length).padStart(2, '0')}</span>
        </div>
        <p class="name-wall-experiment__eyebrow" data-scene-kicker>{battleScenes[0].kicker}</p>
        <h2 data-scene-title>{battleScenes[0].title}</h2>
        <div class="name-wall-experiment__sector-locator" aria-label="Campaign sector locator">
          <div>
            <span data-i18n="sectorLocator">{uiCopy.en.sectorLocator}</span>
            <strong data-sector-caption>Kaksar</strong>
          </div>
          <ol>
            {
              campaignSectors.map((sector) => (
                <li
                  data-sector-marker={sector.id}
                  data-current={sector.id === 'kaksar' ? '' : undefined}
                  data-visited={sector.id === 'kaksar' ? '' : undefined}
                >
                  <i aria-hidden="true" />
                  <span>{sector.label}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <p class="name-wall-experiment__names-label" data-i18n="namesBroughtForward">{uiCopy.en.namesBroughtForward}</p>
        <ul data-scene-summary-names>
          {battleScenes[0].soldierIndices.map((index) => <li>{martyrs[index]?.fullName}</li>)}
        </ul>
        <button
          class="name-wall-experiment__chapter-open"
          type="button"
          data-chapter-open
          aria-haspopup="dialog"
        >
          <span data-i18n="exploreChapter">{uiCopy.en.exploreChapter}</span>
          <span aria-hidden="true">→</span>
        </button>
        <div class="name-wall-experiment__controls">
          <button type="button" data-scene-previous disabled aria-label="Previous chapter">←</button
          >
          <button type="button" data-scene-next aria-label="Next chapter">→</button>
        </div>
      </aside>
    </div>

    <ol class="name-wall-experiment__scenes">
      {
        battleScenes.map((scene, index) => (
          <li
            class="name-wall-experiment__scene"
            data-name-wall-scene={index}
            data-active={index === 0 ? '' : undefined}
          >
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{scene.title}</strong>
          </li>
        ))
      }
    </ol>
  </section>

  <dialog
    class="name-wall-experiment__chapter-dialog"
    data-chapter-dialog
    aria-labelledby="chapter-dialog-title"
  >
    <form method="dialog" class="name-wall-experiment__chapter-close">
      <button type="submit" aria-label="Close chapter details">×</button>
    </form>
    <div class="name-wall-experiment__chapter-sheet">
      <header class="name-wall-experiment__chapter-heading">
        <div class="name-wall-experiment__context-count">
          <span data-dialog-scene-number>01</span>
          <span>/</span>
          <span>{String(battleScenes.length).padStart(2, '0')}</span>
        </div>
        <p class="name-wall-experiment__eyebrow" data-dialog-scene-kicker>
          {battleScenes[0].kicker}
        </p>
        <h2 id="chapter-dialog-title" data-dialog-scene-title>{battleScenes[0].title}</h2>
      </header>

      <div class="name-wall-experiment__chapter-body">
        <button
          class="name-wall-experiment__family-toggle"
          type="button"
          data-family-toggle
          aria-controls="supporting-remembrances"
          aria-expanded="false"
        >
          <span>
            <small data-i18n="supportingRemembrance">{uiCopy.en.supportingRemembrance}</small>
            <strong data-family-toggle-label>Captain Saurabh Kalia · The first cheque</strong>
          </span>
          <span aria-hidden="true" data-family-toggle-arrow>→</span>
        </button>

        <div data-scene-battle>
          <p class="name-wall-experiment__chapter-detail" data-scene-detail>
            {battleScenes[0].detail}
          </p>
          <p class="name-wall-experiment__names-label" data-i18n="namesBroughtForward">{uiCopy.en.namesBroughtForward}</p>
          <ul class="name-wall-experiment__chapter-names" data-scene-names>
            {battleScenes[0].soldierIndices.map((index) => <li>{martyrs[index]?.fullName}</li>)}
          </ul>
          <div class="name-wall-experiment__archive" data-image-gallery>
            <div class="name-wall-experiment__archive-heading">
              <strong data-i18n="chapterArchive">{uiCopy.en.chapterArchive}</strong>
              <span data-i18n="selectToEnlarge">{uiCopy.en.selectToEnlarge}</span>
            </div>
            <div class="name-wall-experiment__archive-grid" data-scene-images>
              {
                battleArchive[0]?.images.map((image) => (
                  <a
                    href={getCommonsFileUrl(image.commonsFile)}
                    target="_blank"
                    rel="noreferrer"
                    title={`${image.credit} · ${image.license}`}
                    data-archive-image
                    data-image-src={image.src}
                    data-image-alt={image.alt}
                    data-image-caption={image.caption}
                    data-image-credit={`${image.credit} · ${image.license}`}
                    data-image-source={getCommonsFileUrl(image.commonsFile)}
                  >
                    <img src={image.src} alt={image.alt} loading="lazy" />
                    <strong>{image.caption}</strong>
                    <span>
                      {image.credit} · {image.license}
                    </span>
                  </a>
                ))
              }
            </div>
            <a
              class="name-wall-experiment__read-more"
              data-scene-read-more
              href={battleArchive[0]?.readMore.url}
              target="_blank"
              rel="noreferrer"
            >
              {battleArchive[0]?.readMore.label}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <article
          id="supporting-remembrances"
          class="name-wall-experiment__family-story"
          data-family-story
          hidden
        >
          {
            initialRemembrances.map((story) => (
              <section class="name-wall-experiment__remembrance-entry">
                <p class="name-wall-experiment__eyebrow">Supporting remembrance · {story.place}</p>
                <h3>{story.title}</h3>
                <p class="name-wall-experiment__family-introduction">{story.introduction}</p>
                {story.images.length > 0 && (
                  <div class="name-wall-experiment__family-gallery" data-image-gallery>
                    {story.images.map((image) => (
                      <a
                        href={image.src}
                        data-archive-image
                        data-image-src={image.src}
                        data-image-alt={image.alt}
                        data-image-caption={image.caption}
                        data-image-credit={story.source}
                      >
                        <img src={image.src} alt={image.alt} loading="lazy" />
                      </a>
                    ))}
                  </div>
                )}
                {story.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                <footer>{story.source}</footer>
              </section>
            ))
          }
        </article>
      </div>
    </div>
  </dialog>

  <section
    class="name-wall-experiment__story name-wall-experiment__story--ending"
    aria-labelledby="ending-title"
  >
    <figure class="name-wall-experiment__story-image">
      <img src={storyChapters.ending.image} alt={storyChapters.ending.imageAlt} loading="lazy" />
      <figcaption>
        <a href={storyChapters.ending.imageUrl} target="_blank" rel="noreferrer">
          Photograph: {storyChapters.ending.imageCredit} ↗
        </a>
      </figcaption>
    </figure>
    <div class="name-wall-experiment__story-copy">
      <p class="name-wall-experiment__eyebrow" data-story="ending-eyebrow">{storyChapters.ending.eyebrow}</p>
      <h2 id="ending-title" data-story="ending-title">{storyChapters.ending.title}</h2>
      {storyChapters.ending.paragraphs.map((paragraph, index) => <p data-story={`ending-paragraph-${index}`}>{paragraph}</p>)}
      <ul aria-label="End of the war in brief">
        {storyChapters.ending.facts.map((fact, index) => <li data-story={`ending-fact-${index}`}>{fact}</li>)}
      </ul>
      <div class="name-wall-experiment__story-links">
        <a href={storyChapters.ending.sourceUrl} target="_blank" rel="noreferrer">
          {storyChapters.ending.sourceLabel} ↗
        </a>
      </div>
    </div>
  </section>

  <section class="name-wall-experiment__closing">
    <p class="name-wall-experiment__eyebrow">One path through a larger remembrance</p>
    <h2>Twenty-four names, held within many more.</h2>
    <p>
      These 24 selected stories are not a complete roll of honour and do not rank sacrifice. They
      stand within the larger remembrance of all who laid down their lives during Operation Vijay.
    </p>
    <div>
      <a href="/tech/kargil-remembrance/">Explore the first remembrance study</a>
      <a href="https://kargilwarmemorial.com/" target="_blank" rel="noreferrer">
        Kargil War Memorial ↗
      </a>
    </div>
  </section>

  <dialog
    class="name-wall-experiment__lightbox"
    data-image-lightbox
    aria-label="Expanded battle photograph"
  >
    <form method="dialog">
      <button type="submit" aria-label="Close expanded photograph">×</button>
    </form>
    <div class="name-wall-experiment__lightbox-frame">
      <img
        data-lightbox-image
        src={battleArchive[0]?.images[0]?.src}
        alt={battleArchive[0]?.images[0]?.alt}
      />
      <div class="name-wall-experiment__lightbox-navigation">
        <button type="button" data-lightbox-previous aria-label="Previous photograph">←</button>
        <button type="button" data-lightbox-next aria-label="Next photograph">→</button>
      </div>
      <div class="name-wall-experiment__lightbox-details">
        <strong data-lightbox-caption></strong>
        <span data-lightbox-credit></span>
        <span class="name-wall-experiment__lightbox-counter" data-lightbox-counter>1 / 3</span>
        <a data-lightbox-source href="" target="_blank" rel="noreferrer">
          <span data-i18n="viewOriginal">{uiCopy.en.viewOriginal}</span> ↗
        </a>
      </div>
    </div>
  </dialog>
</main>

<script>
  import './wall';
  import './entrance';
</script>
